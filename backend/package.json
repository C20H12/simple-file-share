{
  "name": "fileshare-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "test": "node --env-file=.env --test --test-force-exit tests/",
    "minio:up": "docker compose up -d minio",
    "minio:down": "docker compose down"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "minio": "^8.0.7",
    "peer": "^1.0.2"
  }
}
