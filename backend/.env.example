PORT=3000
CORS_ORIGIN=*

# MinIO (S3-compatible file storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=fileshare
MINIO_ROOT_PASSWORD=change-me-dev-only
MINIO_BUCKET=shares

# PeerJS signaling
PEER_PATH=/peer

# Uploaded shares
MAX_SHARE_FILES=100
# Most a share may hold in total, in bytes (50 MB). Keep in step with
# MAX_UPLOAD_BYTES in frontend/src/lib/upload.js.
MAX_SHARE_BYTES=50000000
SWEEP_INTERVAL_MS=60000

# Rate limits, counted per LIMIT_WINDOW_MS:
#   LOOKUP_MAX_MISSES    requests for codes that do not exist, per client address
#   UNLOCK_MAX_FAILURES  wrong passwords, per share
LIMIT_WINDOW_MS=900000
LOOKUP_MAX_MISSES=30
UNLOCK_MAX_FAILURES=10

# Behind a reverse proxy, set this so the limits above see the real client
# address (same values as Express's "trust proxy", e.g. 1). Leave unset otherwise.
# TRUST_PROXY=1
