PORT=3000
CORS_ORIGIN=*

# MinIO (S3-compatible file storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=fileshare
MINIO_ROOT_PASSWORD=change-me-dev-only
MINIO_BUCKET=shares

# PeerJS signaling
PEER_PATH=/peer

# Uploaded shares
MAX_SHARE_FILES=100
MAX_SHARE_BYTES=2147483648
SWEEP_INTERVAL_MS=60000
