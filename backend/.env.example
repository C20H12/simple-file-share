PORT=3000
CORS_ORIGIN=*

# MinIO (S3-compatible file storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=fileshare
MINIO_ROOT_PASSWORD=change-me-dev-only
MINIO_BUCKET=shares

# PeerJS signaling
PEER_PATH=/peer

# Uploaded shares
MAX_SHARE_FILES=100
# Most a share may hold in total, in bytes (50 MB). Keep in step with
# MAX_UPLOAD_BYTES in frontend/src/lib/upload.js.
MAX_SHARE_BYTES=50000000
# Most all shares together may take in storage, in bytes (3 GB). New shares
# are refused with "storage full" once it is reached. Keep it below the disk's
# free space, and below the MinIO bucket quota if one is set.
STORAGE_MAX_BYTES=3000000000
# Hard quota on the MinIO bucket, set by `npm run minio:quota`; a backstop a
# little above STORAGE_MAX_BYTES, refused by MinIO itself if ever reached.
MINIO_BUCKET_QUOTA=3.5GB
SWEEP_INTERVAL_MS=60000
# A download that began before its share expired may continue this long
# afterwards (ms, 1 hour); then it is cut off and the share deleted.
DOWNLOAD_GRACE_MS=3600000

# Rate limits, counted per LIMIT_WINDOW_MS:
#   LOOKUP_MAX_MISSES    requests for codes that do not exist, per client address
#   UNLOCK_MAX_FAILURES  wrong passwords, per share
LIMIT_WINDOW_MS=900000
LOOKUP_MAX_MISSES=30
UNLOCK_MAX_FAILURES=10

# Behind a reverse proxy, set this so the limits above see the real client
# address (same values as Express's "trust proxy", e.g. 1). Leave unset otherwise.
# TRUST_PROXY=1
