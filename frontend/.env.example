# All optional. Copy to .env to change them.

# Where the backend lives, if it is not served from the same origin as this
# app (in development the Vite proxy makes it same-origin).
# VITE_API_URL=https://api.example.com

# Path of the PeerJS signaling endpoint on the backend (its PEER_PATH).
# VITE_PEER_PATH=/peer

# ICE servers for peer share, as a JSON array in RTCIceServer format. When
# unset, PeerJS's defaults are used. Set this to use your own, or to [] for
# none (same-network transfers only).
# VITE_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]

# PeerJS console logging while debugging peer share: 0 (off) to 3 (everything).
# VITE_PEER_DEBUG=3
